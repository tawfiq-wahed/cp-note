void bfs_jan(int xs,int ys)
{
   mem(jan,-1);
   queue<pair<int,int>>q;
    q.push({xs,ys});
    jan[xs][ys]=0;
    while(!q.empty())
    {
        int x=q.front().F;
        int y=q.front().S;
        q.pop();
        for(int i=0;i<4;i++)
        {
            int x1=x+dx[i];
            int y1=y+dy[i];
            if(x1>=1 &&x1<=n &&y1>=1 &&y1<=m &&c[x1][y1]!='#' &&jan[x1][y1]==-1 &&jan[x][y]+1<fire[x1][y1])
            {
                jan[x1][y1]=jan[x][y]+1;
                q.push({x1,y1});
            }
        }
    }
}

