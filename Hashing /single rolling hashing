ll mul(ll a,ll b)
{
    return ((((a%mod)+mod)%mod)*(((b%mod)+mod)%mod))%mod;
}

ll add(ll a,ll b)
{
    return ((((a%mod)+mod)%mod)+(((b%mod)+mod)%mod))%mod;
}
ll binexpo(ll a,ll b)
{
   ll res=1ll;
   if(b==0)return 1ll;
   res=binexpo(a,b/2);
   if(b%2)
   {
       res=mul(res,res);
       res=mul(res,a);
   }
   else res=mul(res,res);
   return res;
}
ll pw[mx];
ll inv[mx];
ll hashi[mx];
void precal()
{
    pw[0]=1;
    ll base=30;
    for(int i=1;i<mx;i++)
    {
        pw[i]=mul(pw[i-1],base);
    }
        ll inv_p=binexpo(base,mod-2);
        inv[0]=1;
        for(int i=1;i<mx;i++)
    {
        inv[i]=mul(inv[i-1],inv_p);
    }
}
void build(string s)
{
    int n=s.size();
    mem(hashi,0);
    for(int i=0;i<n;i++)
    {
       hashi[i]=add((i==0)?0:hashi[i-1],mul(pw[i],s[i]-'a'+1));

    }
}
ll gethash(int l,int r)
{
   ll res=add(hashi[r],-((l==0)?0:hashi[l-1]));
   res=mul(res,inv[l]);
   return res;
}

void solve()
{
string s,k;
cin>>s>>k;

build(k);

ll rr=gethash(0,k.size()-1);
mem(hashi,0);
int c=0;
build(s);

for(int i=0;i+k.size()-1<s.size();i++)
{
    ll ff=gethash(i,i+k.size()-1);
   // cout<<ff<< " "<<rr<<endl;
    if(rr==ff)c++;

}
cout<<c<<endl;
}



