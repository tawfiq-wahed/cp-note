ll mul(ll a,ll b,ll mod)
{
    return ((((a%mod)+mod)%mod)*(((b%mod)+mod)%mod))%mod;
}

ll add(ll a,ll b,ll mod)
{
    return ((((a%mod)+mod)%mod)+(((b%mod)+mod)%mod))%mod;
}
ll binexpo(ll a,ll b,ll mod)
{
   ll res=1ll;
   if(b==0)return 1ll;
   res=binexpo(a,b/2,mod);
   if(b%2)
   {
       res=mul(res,res,mod);
       res=mul(res,a,mod);
   }
   else res=mul(res,res,mod);
   return res;
}
ll pw1[mx],pw2[mx];
ll inv1[mx],inv2[mx];
ll hash1[mx],hash2[mx];
void precal()
{
    pw1[0]=pw2[0]=1;
    ll base=137;
    for(int i=1;i<mx;i++)
    {
        pw1[i]=mul(pw1[i-1],base,mod1);
          pw2[i]=mul(pw2[i-1],base,mod2);
    }
        ll inv_p1=binexpo(base,mod1-2,mod1);
        ll inv_p2=binexpo(base,mod2-2,mod2);
        inv1[0]=inv2[0]=1;
        for(int i=1;i<mx;i++)
    {
        inv1[i]=mul(inv1[i-1],inv_p1,mod1);
        inv2[i]=mul(inv2[i-1],inv_p2,mod2);
    }
}
void build(string s)
{
    int n=s.size();
    mem(hash1,0);
     mem(hash2,0);
    for(int i=0;i<n;i++)
    {
       hash1[i]=add((i==0)? 0ll :hash1[i-1],mul(pw1[i],s[i]-'a'+1,mod1),mod1);
  hash2[i]=add((i==0)? 0ll :hash2[i-1],mul(pw2[i],s[i]-'a'+1,mod2),mod2);

    }
}
pair<ll,ll> gethash(ll l,ll r)
{
   ll res1=add(hash1[r],-((l==0)?0:hash1[l-1]),mod1*1ll);
   res1=mul(res1,inv1[l],mod1);
   ll res2=add(hash2[r],-((l==0)?0:hash2[l-1]),mod2*1ll);
   res2=mul(res2,inv2[l],mod2);
   return {res1,res2};
}

void solve()
{
