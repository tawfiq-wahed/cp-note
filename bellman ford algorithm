void sieve(ll n)
{ isprime[2]=1;
    for(ll i=3;i<=n;i+=2)isprime[i]=1;
    for(ll i=2;i*i<=n;i++)
    {
        if(isprime[i])
        {
            for(ll j=i*i;j<=n;j+=i)
            {
                isprime[j]=0;
            }
        }
    }
    primes.pb(2);
    for(ll i=3;i<=n;i++)
    {
        if(isprime[i])primes.pb(i);
    }
}
