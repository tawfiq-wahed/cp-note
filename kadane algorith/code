#include <bits/stdc++.h>
using namespace std;
#define ll long long

pair<ll,pair<ll,ll>>max_subarray_sum(vector<ll>& a)
{  ll n=a.size();
    ll max_sum = a[0];
    ll current_sum = a[0];
    ll start = 0;
    ll end = 0;
    ll max_start = 0;
    ll max_end = 0;

    for (int i = 1; i < n; i++) {

        if (a[i] > current_sum + a[i]) {
            start = i;
        }
        current_sum = max(a[i], current_sum + a[i]);
        if (current_sum > max_sum) {
            max_sum = current_sum;
            end = i;
            max_start = start;
            max_end = end;
        }
    }
    return {max_sum,{max_start,max_end}};
}

