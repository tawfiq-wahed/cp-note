vi primes;
void sieve(int n)
{vis[2]=1;
    for(int i=3;i<=n;i+=2)vis[i]=1;
    primes.pb(2);

    for(int i=2;i<=sqrt(n);i++)
    {
        if(vis[i])
           {
               for(int j=i*i;j<=n;j+=i)
                {
                    vis[j]=0;
                }
           }
    }
    for(int i=3;i<=n;i+=2)if(vis[i])primes.pb(i);
}
