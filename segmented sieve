ll binexpo(ll a,ll b)
{
    ll res=1ll;
    if(b==0)return 1ll;
    res=binexpo(a,b/2);
    if(b%2)
    {
        res=mul(res,res);
        res=mul(res,a);
    }
    else {
            res=mul(res,res);
    }
    return res;
}
