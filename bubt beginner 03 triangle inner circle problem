void sieve(int n)
{
    for(int i=3;i<=n;i+=2)vis[i]=1;
    vis[2]=1;
    for(int i=3;i*i<=n;i+=2)
    {
        if(vis[i])
        {
            for(int j=i*i;j<=n;j+=i)
            {
                vis[j]=0;
            }
        }
    }
}
