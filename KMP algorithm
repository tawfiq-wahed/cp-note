#include <bits/stdc++.h>
using namespace std;

vector<int> prefix_function(string p)
{
    int n = p.size();
    vector<int> pi(n);

    for (int i = 1; i < n; i++)
    {
        int j = pi[i - 1];

        while (j > 0 && p[i] != p[j])
            j = pi[j - 1];

        if (p[i] == p[j])
            j++;

        pi[i] = j;
    }

    return pi;
}

vector<int> KMP(string text, string pattern)
{
    vector<int> pi = prefix_function(pattern);

    vector<int> positions;

    int n = text.size();
    int m = pattern.size();

    int j = 0;

    for (int i = 0; i < n; i++)
    {
        while (j > 0 && text[i] != pattern[j])
            j = pi[j - 1];

        if (text[i] == pattern[j])
            j++;

        if (j == m)
        {
            positions.push_back(i - m + 1);

            // overlapping occurrence-এর জন্য
            j = pi[j - 1];
        }
    }

    return positions;
}

int main()
{
    string text, pattern;

    cin >> text >> pattern;

    vector<int> ans = KMP(text, pattern);

    for (int pos : ans)
        cout << pos << " ";

    return 0;
}



