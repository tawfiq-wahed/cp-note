#include<bits/stdc++.h>
using namespace std;

#define ll long long

vector<ll> dp;

ll mex(const unordered_set<ll>& st)
{
    ll x=0;

    while(st.count(x))
        x++;

    return x;
}

ll grundy(ll n,ll k)
{
    if(n==0)
        return 0;

    if(dp[n]!=-1)
        return dp[n];

    unordered_set<ll> st;

    for(int i=1;i<=k;i++)
    {
        if(n-i>=0)
        {
            st.insert(grundy(n-i,k));
        }
    }

    return dp[n]=mex(st);
}

int main()
{
    ll n=10;
    ll k=3;

    dp.assign(n+1,-1);

    cout<<grundy(n,k)<<endl;
}
