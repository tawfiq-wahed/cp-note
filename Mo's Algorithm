ll mul(ll a,ll b)
{
    return ((((a%mod)+mod)%mod)*(((b%mod)+mod)%mod))%mod;
}
ll add(ll a,ll b)
{
    return ((((a%mod)+mod)%mod)+(((b%mod)+mod)%mod))%mod;
}
ll binexpo(ll a,ll b)
{
    if(b==0)return 1;
    ll res=1;
    res=binexpo(a,b/2);
    if(b%2)
    {
        res=mul(res,res);
        res=mul(res,a);
    }
    else res=mul(res,res);
   // cout<<b<<" "<<res<<endl;
    return res;
}

