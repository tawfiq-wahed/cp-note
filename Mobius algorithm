//mobius algorithm
int mu[mx+1];
int isprime[mx+1];
vll primes;
void mobius()
{
    for(int i=0;i<=mx;i++)mu[i]=1;
    mem(isprime,1);
    for(int i=2;i<=mx;i++)
    {
        if(isprime[i])
        {
            primes.pb(i);
            mu[i]=-1;
        }
        for(auto p:primes)
        {
            if(i*p>n)break;
            isprime[i*p]=0;
            if(i%p==0)
            {
                mu[i*p]=0;
                break;
            }
            else mu[i*p]=-mu[i];
        }
    }
    
}
// number of pair with gcd=1 
ll cnting(vll &a)
{
    vll cnt(mx+1,0);
    for(auto u:a)cnt[u]++;
    for(int i=1;i<=mx;i++)
    {
        for(int j=i;j<=n;j+=i)
        {
            cnt[i]+=cnt[j];
        }
    }
    ll ans=0;
    for(int i=1;i<=mx;i++)ans+=1ll*mu[i]*cnt[i]*(cnt[i]-1)*2;
    return ans;
    
}
