void dijkstra(int s,int n)
{vll v1;
    for(int i=0;i<=n;i++)dist[i]=inf;
    dist[s]=0;
    priority_queue<pll,vpll,greater<pll>>pq;
    pq.push({0,s});
    while(!pq.empty())
    {
        ll u=pq.top().S;
        ll w=pq.top().F;
        pq.pop();
        if(dist[u]<w)continue;
        for(auto v:adj[u])
        {
            ll x=v.F;
            ll y=v.S;
            if(w+y<dist[x])
            {
                dist[x]=w+y;
                pq.push({dist[x],x});
            }
        }
    }
}
