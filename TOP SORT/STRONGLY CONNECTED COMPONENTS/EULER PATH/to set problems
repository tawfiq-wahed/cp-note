//0(n) e check kore amr element gula k right position e boshai
void ramadan_kareem(int tc,int t5)
{
   int n;
   cin>>n;
   vll v(n+1);
   for(int i=1;i<=n;i++)cin>>v[i];
   for(int i=1;i<=n;)
   {
       int x=v[i];
       if(x>=1 &&x<=n &&x!=v[x])
       {
           swap(v[i],v[x]);
       }
       else i++;
   }
   for(int i=1;i<=n;i++)cout<<v[i]<<" ";
   cout<<endl;
}
