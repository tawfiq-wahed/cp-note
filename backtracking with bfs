vi ret(200,0);
vector<bool>vis(200,0);
vi adj[200];
int k;
int dfs(int v)
{
    vis[v]=1;
    if(ret[v]!=0)return ret[v];
    if(adj[v].size()==0)
    {
       ret[v]=0;
       return ret[v];
    }k=0;
    for(auto u:adj[v])
    {
        if(!vis[u])
        {
            ret[v]+=(dfs(u)+1);
        }
       // ret[v]=max(ret[v],k);
        // cout<<v<<" "<<ret[v]<<endl;
    }
    return ret[v];
}
