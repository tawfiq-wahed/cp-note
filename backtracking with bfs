vi ret(200,0);
vector<bool>vis(200,0);
vi adj[200];
int dfs(int v)
{
    vis[v]=1;
    if(ret[v]!=0)return ret[v];
    if(adj[v].size()==0)
    {
       ret[v]=0;
       return ret[v];
    }
    for(auto u:adj[v])
    {
        if(!vis[u])
        {
            ret[v]=max(ret[v],dfs(u)+1);
          //  cout<<v<<" "<<ret[v]<<endl;
        }
    }
    return ret[v];
}
void solve()
{
int n,m;
cin>>n>>m;
int a,b;
while(m--)
{
    cin>>a>>b;
    adj[a].pb(b);
  //  adj[b].pb(a);
}
dfs(1);
for(int i=1;i<=n;i++)cout<<ret[i]<<" ";
cout<<endl;
}



 int main()
 {
     tawfiq();
    int t=1;
//cin>>t;
//sieve(1000000);
for(int i=1;i<=t;i++)
     {
       solve();
