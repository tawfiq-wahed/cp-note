ll binexpo(ll a,ll b)
{
    if(b==0)return 1;
    ll res=1;
    res=binexpo(a,b/2);
    if(b%2){
            res=mul(res,res);
            res=mul(res,a);
    }
    else res=mul(res,res);
    return res;
}

void solve()
{
ll n,m,k;
cin>>n>>m>>k;
ll l=1,r=1e12,mid,z,ans=-1;
auto check=[&](ll rid)->bool
{
    for(int i=0;i<n;i++)
    {
        rid-=(rid/m);
        if(rid<=0)return 0;
    }
   return (rid>=k);
};
while(l<=r)
{
    mid=(l+r)/2;
    z=mid;
    if(check(z))
    {ans=mid;
        r=mid-1;
    }
    else l=mid+1;
}
cout<<ans<<endl;
}




