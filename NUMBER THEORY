#include<bits/stdc++.h>
using namespace std;
#define tawfiq() ios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0);
#define fraction() cout.unsetf(ios::floatfield);cout.precision(10);cout.setf(ios::fixed,ios::floatfield);
#define pb push_back
#define endl '\n'
#define ll long long
const int mx=1e6+1;
bool isprime[mx];
vector<int>primes;

void sieve(int n)
{
    for(int i=3;i<=mx;i+=2)isprime[i]=1;
int sq=sqrt(n);
for(int i=3;i<=sq;i+=2)
{
    if(isprime[i]==1)
    {
        for(int j=i*i;j<=n;j+=i)
    {
        isprime[j]=0;
    }
    }
}
isprime[2]=1;
primes.pb(2);
for(int i=3;i<=n;i+=2)
{
  if(isprime[i]==1)  primes.pb(i);
}
}
vector<int>prime_factor(int n)
{int c=0;
vector<int>factors;
    for(auto u:primes)
    {if((u*u)>n)break;
        if(n%u==0)
        {
            while(n%u==0)
            {
                c++;
                n/=u;
                factors.pb(u);
            }
        }
    }
    if(n>1){
            factors.pb(n);
    }
    return factors;
}
